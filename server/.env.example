NODE_ENV=development
PORT=3000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=xtx_mall
DB_USER=root
DB_PASSWORD=

JWT_SECRET=change_me_in_production
JWT_ACCESS_EXPIRES=2h
JWT_REFRESH_EXPIRES=7d

UPLOAD_DRIVER=local
UPLOAD_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:3000/uploads

PAY_ADAPTER=sandbox
PAY_SECRET=change_me_in_production
SMS_ADAPTER=console
LOGISTICS_ADAPTER=mock

# 登录图形验证码（U-41 防爆破）：false 可在本地联调时关闭
CAPTCHA_ENABLED=true

CORS_ORIGIN=http://localhost:5173

# ============ AI 智能客服（DeepSeek） ============
# API Key 只写在这里，不要提交到 Git。
# 留空时自动降级为演示模式（mock 适配器）：功能可跑通，但回答是内置话术。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

AI_ENABLED=true
AI_ADAPTER=deepseek
AI_TIMEOUT_MS=25000
AI_MAX_TOKENS=900
AI_TEMPERATURE=0.3
# 场景开关（部署级）。运行期可用 settings 表覆盖：
#   ai.scenario.<场景>.enabled / ai.scenario.<场景>.grayUserIds
AI_SCENARIOS=customer_service,search_parse,marketing_copy,helpdesk_draft

# 分模块每日成本上限（元）：后台场景上线后不再与用户端抢额度。
# 未配置时 chat 回落到 AI_DAILY_BUDGET_CNY，admin/other 使用默认值。
AI_BUDGET_CHAT_CNY=12
AI_BUDGET_ADMIN_CNY=6
AI_BUDGET_OTHER_CNY=2
# 分模块每分钟调用上限（单用户 / 单管理员）
AI_RATE_CHAT_PER_MIN=12
AI_RATE_ADMIN_PER_MIN=30
AI_RATE_OTHER_PER_MIN=60
# 搜索解析硬预算：超时即退回纯关键词检索（文档建议 300，实测需放宽到 2s 量级）
AI_SEARCH_PARSE_TIMEOUT_MS=2500
# 结果缓存 TTL（毫秒），0 表示关闭
AI_CACHE_TTL_MS=600000
# 熔断：连续失败阈值与冷却时间
AI_BREAKER_THRESHOLD=5
AI_BREAKER_COOLDOWN_MS=60000

# 遗留的总量上限（可选）：AI_BUDGET_CHAT_CNY 未配置时作为用户端预算使用
AI_DAILY_BUDGET_CNY=20
# 成本估算单价（元/百万 token），仅用于后台统计
AI_PRICE_IN_PER_M=2
AI_PRICE_OUT_PER_M=8
# 送入模型的历史消息条数
AI_MAX_HISTORY=8

# 向量能力（默认关闭；DeepSeek 无 embedding 接口，关闭时全链路可用）
AI_EMBEDDING_ENABLED=false
AI_EMBEDDING_MODEL=
